<!-- Source77NW.NT.csproj - Copyright (c) GDFrank
     SPDX-License-Identifier: Apache-2.0
     ================================================================
     The NT.Forms flavor dll: Source77NW.NT.Forms.dll = Core.Base's
     sources compiled IN + Core.NT's NT-dependent modules (registry,
     system management, shell...) + UI.Base/UI.NT.Base/UI.NT.Forms's
     UI modules - all linked globs below, no ProjectReference (an
     exe links exactly ONE Source77NW dll). Pure-classification
     layout: this project folder holds ONLY this csproj + README - no
     source of its own. Sources live in the pure classification
     folders Core.Base\, Core.NT\, UI.Base\, UI.NT.Base\, UI.NT.Forms\
     (plain *.cs, no csproj, no subfolders) - see ..\README.md for
     the DLL/tier naming scheme. ALL sources declare the single
     Source77NW namespace. Never link this dll and
     Source77NW.Core.Base.dll (or Source77NW.Core.NT.dll) together -
     every type they hold already exists in here too.
     The static NT class (NT.cs, in Core.NT\) holds isolated NT
     system functions, with nested static classes grouping a subject
     (NT.Mgmt, NT.MediaDrive, NT.RegVals, NT.Recycle). The UI.Base\/
     UI.NT.Base\/UI.NT.Forms\ tiers are the library-grade UI tiers -
     reserved, pending curation; the Samples\ tree carries its own
     simplified illustration under a parallel Core.Base\/UI.Base\/
     UI.NT.Base\/UI.NT.Forms\ tree, not linked from here.
     net8.0/net10.0 use the -windows suffix: NT.RegVals.cs
     (Microsoft.Win32.Registry) and NT-PutInfoSys.cs (Registry + kernel32
     P/Invoke) are compile-time Windows-bound sources, so CA1416
     (Platform Compatibility) fires on every call site under a
     non-windows TFM. -windows makes the analyzer treat this whole
     project as Windows-only, matching what it already is - net481
     needs no suffix (Framework APIs are always "compatible").
     ================================================================ -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net481;net8.0-windows;net10.0-windows</TargetFrameworks>
    <AssemblyName>Source77NW.NT.Forms</AssemblyName>
    <RootNamespace>Source77NW</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>$(Major).0.0.0</AssemblyVersion>
    <!-- 4-part M.m.p.b: Build (Directory.Version.props) counts content
         refreshes since the M.m.p release (release = .0). -->
    <Version>$(Major).$(Minor).$(Patch).$(Build)</Version>

    <BuildYear>$([System.DateTime]::Now.ToString(yyyy))</BuildYear>
    <BuildMonth>$([System.DateTime]::Now.ToString(MM))</BuildMonth>
    <BuildDay>$([System.DateTime]::Now.ToString(dd))</BuildDay>
    <BuildHHmm>$([System.DateTime]::Now.ToString(HHmm))</BuildHHmm>
    <BuildStamp>$(BuildYear).$(BuildMonth).$(BuildDay).$(BuildHHmm)</BuildStamp>

    <InformationalVersion>$(Version)+$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <!-- Core.Base/Core.NT/UI.Base/UI.NT.Base/UI.NT.Forms sources live in
       the pure classification folders (no csproj there, so no bin\/obj\
       to exclude); linked in here so this project builds them as its
       own. LinkBase groups them under matching nodes in the IDE. -->
  <ItemGroup>
    <Compile Include="..\Core.Base\**\*.cs" LinkBase="Core.Base" />
    <Compile Include="..\Core.NT\**\*.cs" LinkBase="Core.NT" />
    <Compile Include="..\UI.Base\**\*.cs" LinkBase="UI.Base" />
    <Compile Include="..\UI.NT.Base\**\*.cs" LinkBase="UI.NT.Base" />
    <Compile Include="..\UI.NT.Forms\**\*.cs" LinkBase="UI.NT.Forms" />
  </ItemGroup>

  <!-- net481: framework assemblies not in the SDK implicit set
       (needed by the compiled-in Core.Base sources; mirrors Core.Base
       csproj). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- NT.Mgmt uses dynamic (RuntimeBinder) for reflection-only WMI
         access; net8.0/net10.0 carry Microsoft.CSharp in-box via the
         SDK's implicit framework reference, net481 does not. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
