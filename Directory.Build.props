<!-- Directory.Build.props - Copyright (c) GDFrank
     SPDX-License-Identifier: Apache-2.0
     ================================================================
     Repo-wide MSBuild properties. MSBuild auto-imports this file
     into EVERY .csproj under this directory tree - no reference
     needed. Identity/metadata lives here once; per-project files
     keep only what genuinely differs (TFMs, references).

     RECREATED 2026-09-01: G manually deleted every file in RepoPub
     except .git*, for a clean re-test of the first real dev.sync -
     that included this file, which is repo-identity (never synced
     from RepoDev, per Sync-WipToPub.ps1's excludeFiles) and has no
     automated recreation step, unlike Directory.Version.props.
     Content mirrors RepoDev's copy verbatim - both repos describe
     the same product/package identity, nothing here should differ
     between them.
     ================================================================ -->

<Project>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Version.props')" />

  <PropertyGroup>
    <!-- Package/assembly identity (used by NuGet pack + AssemblyInfo) -->
    <Authors>GDFrank</Authors>
    <Company>GDFrank</Company>
    <Product>Source77NW</Product>
    <Copyright>Copyright (c) GDFrank</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GDFrank/Source77NW</RepositoryUrl>
    <PackageProjectUrl>https://github.com/GDFrank/Source77NW</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build hygiene, repo-wide -->
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
