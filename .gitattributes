# Source77NW - line-ending and diff law for this repo.
# Git stores LF internally; rules below govern working copies.

# Default: normalize all text files (LF in repo, platform eol on checkout)
* text=auto

# C# sources: CRLF in every working copy (project convention),
# and use git's C#-aware diff (hunk headers show method names).
*.cs      text eol=crlf diff=csharp

# Visual Studio files are CRLF-native
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Docs, config, data: CRLF in every working copy. This project's
# whole audience is Windows/.NET (WinExe target, VS solution files,
# the .cs/.sln/.csproj rules above already force CRLF) - so anything
# text-based a downloader might see (via a packaged zip) should match
# that, deterministically, no matter which machine's git config
# produced the checkout it came from. Bare "text" (no eol=) leaves
# this to core.autocrlf instead, which is per-machine and doesn't
# travel with the repo.
*.md      text eol=crlf
*.txt     text eol=crlf
*.yml     text eol=crlf
*.json    text eol=crlf
*.editorconfig text eol=crlf
*.gitignore    text eol=crlf
*.gitattributes text eol=crlf

# .cmd/.bat: CRLF is a hard requirement, not a preference - cmd.exe's
# own GOTO/label parser breaks on LF-only (real incident, 2026-08-06;
# RepoDev's own copy of this file carries the same rule).
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binaries: never normalize, never diff as text
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary
*.zip     binary
*.dll     binary
*.exe     binary
*.pdb     binary
